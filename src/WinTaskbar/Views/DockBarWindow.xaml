<Window x:Class="WinTaskbar.Views.DockBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinTaskbar Notch"
        Width="580" Height="170"
        WindowStartupLocation="Manual"
        Top="0"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <ResourceDictionary Source="/Styles/FluentTheme.xaml" />
    </Window.Resources>

    <!-- Main Floating Black Pill Notch Container (Dynamic Island Style) -->
    <Grid VerticalAlignment="Top" HorizontalAlignment="Center">
        <Border x:Name="PillBorder"
                Width="280" Height="38"
                CornerRadius="19"
                BorderThickness="1"
                Background="#F507090D"
                BorderBrush="#33FFFFFF"
                Padding="0"
                MouseEnter="PillBorder_MouseEnter"
                MouseLeave="PillBorder_MouseLeave"
                Cursor="Arrow">
            
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.65" Color="#000000" />
            </Border.Effect>

            <Grid>
                <!-- Specular Top Rim Reflection Line -->
                <Border Height="1" VerticalAlignment="Top" Margin="24,1,24,0" Background="#3DFFFFFF" IsHitTestVisible="False" />

                <!-- ================= 1. COLLAPSED VIEW (COMPACT BLACK PILL) ================= -->
                <Grid x:Name="GridCollapsed" Height="36" VerticalAlignment="Center" Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Mini Spotify/Media Indicator -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="11" Background="#1DB954" Margin="0,0,6,0">
                            <TextBlock x:Name="TxtMiniMediaIcon" Text="♫" FontSize="11" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="TxtMiniWaveform" Text="ılıı" FontSize="11" FontWeight="Bold" Foreground="#1DB954" VerticalAlignment="Center" Margin="0,0,6,0" />
                    </StackPanel>

                    <!-- Center: Music Title or Clock -->
                    <TextBlock x:Name="TxtCollapsedTitle"
                               Grid.Column="1"
                               Text="Spotify • WinTaskbar"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="130" />

                    <!-- Right: Quick Stat & Mini Play Button -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtCollapsedStats"
                                   Text="14% RAM"
                                   FontSize="11"
                                   Foreground="#99FFFFFF"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />

                        <Button x:Name="BtnMiniPlayPause"
                                Click="BtnQuickPlayPause_Click"
                                Background="#26FFFFFF"
                                BorderThickness="0"
                                Width="24" Height="24"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock x:Name="TxtMiniPlayPauseIcon" Text="▶" FontSize="10" Foreground="White" Margin="1,0,0,0" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ================= 2. EXPANDED VIEW (DYNAMIC ISLAND CARD) ================= -->
                <Grid x:Name="GridExpanded" Visibility="Collapsed" Opacity="0" Margin="14,10,14,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ROW 1: SPOTIFY / MEDIA EXPANDED CARD -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Album Art -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="#1AFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" Margin="0,0,10,0">
                            <Grid>
                                <Image x:Name="ImgExpandedAlbum" Stretch="UniformToFill" />
                                <TextBlock x:Name="TxtAlbumPlaceholder" Text="♫" FontSize="20" Foreground="#55FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Track Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtExpandedTrackTitle"
                                       Text="Nenhuma música tocando"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TxtExpandedArtist"
                                       Text="Spotify"
                                       FontSize="11"
                                       Foreground="#A0A5B5"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Media Controls: Prev, Play/Pause, Next -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnPrevTrack" Click="BtnPrevTrack_Click" Width="30" Height="30" Background="#1AFFFFFF" BorderThickness="0" Margin="2,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="⏮" FontSize="12" Foreground="White" />
                            </Button>

                            <Button x:Name="BtnExpandedPlayPause" Click="BtnQuickPlayPause_Click" Width="36" Height="36" Background="#1DB954" BorderThickness="0" Margin="4,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock x:Name="TxtExpandedPlayPauseIcon" Text="▶" FontSize="14" FontWeight="Bold" Foreground="Black" Margin="1,0,0,0" />
                            </Button>

                            <Button x:Name="BtnNextTrack" Click="BtnNextTrack_Click" Width="30" Height="30" Background="#1AFFFFFF" BorderThickness="0" Margin="2,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="⏭" FontSize="12" Foreground="White" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Divider -->
                    <Rectangle Grid.Row="1" Height="1" Fill="#20FFFFFF" Margin="0,0,0,8" />

                    <!-- ROW 2: SYSTEM STATS ROW + QUICK SHORTCUTS -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- System Stat Pills -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- CPU Pill -->
                            <Button x:Name="BtnCpu" Click="BtnCpu_Click" Background="#16FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" Height="28" Padding="8,0" Margin="0,0,6,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡" FontSize="10" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtCpuQuick" Text="0%" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- RAM Pill -->
                            <Button x:Name="BtnRam" Click="BtnRam_Click" Background="#16FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" Height="28" Padding="8,0" Margin="0,0,6,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🧠" FontSize="10" Foreground="#A78BFA" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtRamQuick" Text="0%" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Network Speed -->
                            <Button x:Name="BtnNet" Click="BtnNet_Click" Background="#16FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" Height="28" Padding="8,0" Margin="0,0,6,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🌐" FontSize="10" Foreground="#34D399" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtNetQuick" Text="0B/s" FontSize="11" Foreground="White" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Disk Speed -->
                            <Button x:Name="BtnDisk" Click="BtnDisk_Click" Background="#16FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" Height="28" Padding="8,0" Margin="0,0,6,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💾" FontSize="10" Foreground="#F59E0B" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtDiskQuick" Text="0B/s" FontSize="11" Foreground="White" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Quick Action Buttons: Start Menu & Search -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Start Menu Button -->
                            <Button x:Name="BtnStartMenu" Click="BtnStartMenu_Click" ToolTip="Menu Iniciar" Background="#26FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" Height="28" Width="28" Margin="0,0,6,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="⊞" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                            </Button>

                            <!-- Quick Search Button -->
                            <Button x:Name="BtnSearchLauncher" Click="BtnSearchLauncher_Click" ToolTip="Pesquisar" Background="#26FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" Height="28" Width="28" Margin="0,0,6,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="🔍" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>

                            <!-- Pin/Lock Expand Button -->
                            <Button x:Name="BtnPinNotch" Click="BtnPinNotch_Click" ToolTip="Fixar / Desafixar Expansão" Background="#16FFFFFF" BorderThickness="0" Height="28" Width="28" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock x:Name="TxtPinIcon" Text="📌" FontSize="11" Foreground="#88FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
