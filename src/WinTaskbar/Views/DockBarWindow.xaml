<Window x:Class="WinTaskbar.Views.DockBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinTaskbar Dock"
        Height="76" SizeToContent="Width"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <ResourceDictionary Source="/Styles/FluentTheme.xaml" />
    </Window.Resources>

    <!-- Liquid Glass Dock Container (Leaves headroom above for macOS wave scaling) -->
    <Border VerticalAlignment="Bottom"
            Height="54"
            Background="#E6161619"
            BorderBrush="#38383F"
            BorderThickness="1"
            CornerRadius="26"
            Padding="8,4"
            Margin="6,0,6,6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

            <!-- SECTION 1: START MENU & SEARCH -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Start Button (Windows / Luma style) -->
                <Button x:Name="BtnStartMenu"
                        ToolTip="Menu Iniciar"
                        Background="#26FFFFFF"
                        BorderThickness="0"
                        Cursor="Hand"
                        Width="38" Height="38"
                        Click="BtnStartMenu_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="19">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{StaticResource AccentCyanBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="⊞" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                </Button>

                <!-- Search Pill -->
                <Button x:Name="BtnSearchLauncher"
                        ToolTip="Pesquisa Rápida (Alt+Espaço)"
                        Background="#1FFFFFFF"
                        BorderBrush="#26FFFFFF"
                        BorderThickness="1"
                        Cursor="Hand"
                        Height="34"
                        Margin="6,0,0,0"
                        Padding="10,0"
                        Click="BtnSearchLauncher_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="17"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#33FFFFFF" />
                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔍" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Buscar..." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Vertical Divider -->
            <Rectangle Width="1" Fill="#26FFFFFF" Margin="10,6" Height="24" />

            <!-- SECTION 2: APPS DOCK (PINNED & RUNNING APPS WITH MAC MAGNIFICATION WAVE) -->
            <ItemsControl x:Name="ItemsDockApps"
                          VerticalAlignment="Center"
                          MouseMove="ItemsDockApps_MouseMove"
                          MouseLeave="ItemsDockApps_MouseLeave">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- macOS Pinned vs Running Divider -->
                            <Rectangle Width="1" Fill="#33FFFFFF" Margin="4,8,4,8" Height="22">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowSeparatorBefore}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>

                            <!-- Dock Icon Button with macOS Magnification Wave -->
                            <Button ToolTip="{Binding Name}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Width="42" Height="44"
                                    Margin="2,0"
                                    Click="BtnDockApp_Click"
                                    MouseRightButtonUp="BtnDockApp_RightClick"
                                    RenderTransformOrigin="0.5, 0.95">
                                <Button.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
                                </Button.RenderTransform>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="12">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#22FFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="36" Height="38">
                                    <!-- App Icon -->
                                    <Image Source="{Binding Icon}" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0">
                                        <Image.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="2" Opacity="0.3" Color="Black" />
                                        </Image.Effect>
                                    </Image>

                                    <!-- Notification Badge (Red Pill) -->
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Background="#FF3B30"
                                            CornerRadius="7"
                                            Height="14" MinWidth="14"
                                            Padding="3,0"
                                            Margin="0,0,-4,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.5" Color="#000000" />
                                        </Border.Effect>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasBadge}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding BadgeText}"
                                                   Foreground="White"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Running / Active Indicator Dot (Bottom) -->
                                    <Border Width="4" Height="4"
                                            CornerRadius="2"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,0,1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentCyanBrush}" />
                                                        <Setter Property="Width" Value="10" />
                                                        <Setter Property="Height" Value="3" />
                                                        <Setter Property="CornerRadius" Value="1.5" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Background" Value="#AAFFFFFF" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Vertical Divider -->
            <Rectangle Width="1" Fill="#26FFFFFF" Margin="10,6" Height="24" />

            <!-- SECTION 3: SPOTIFY / MEDIA LIVE WIDGET -->
            <Button x:Name="BtnMedia" Click="BtnMedia_Click"
                    ToolTip="Spotify / Reprodutor de Mídia"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Padding="6,2" Height="36">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Spotify Green Badge -->
                    <Border Width="22" Height="22" CornerRadius="11" Background="#1DB954" Margin="0,0,6,0">
                        <TextBlock Text="♫" FontSize="11" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <!-- Track Title / Status -->
                    <TextBlock x:Name="TxtMediaStatus" Text="Spotify"
                               FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" MaxWidth="130"
                               TextTrimming="CharacterEllipsis" />
                    <!-- Mini Play/Pause Quick Button -->
                    <Button x:Name="BtnQuickPlayPause" Click="BtnQuickPlayPause_Click"
                            ToolTip="Play / Pause" Width="22" Height="22" Margin="6,0,0,0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <TextBlock x:Name="TxtQuickPlayPauseIcon" Text="▶" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Button>

            <!-- Vertical Divider -->
            <Rectangle Width="1" Fill="#26FFFFFF" Margin="10,6" Height="24" />

            <!-- SECTION 4: SYSTEM LIVE WIDGETS (WINTASKBAR MONITORS) -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- CPU Widget -->
                <Button x:Name="BtnCpu" Click="BtnCpu_Click"
                        ToolTip="Monitor de CPU"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6,2" Height="34">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#26FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚙" FontFamily="Segoe UI Symbol" FontSize="13" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock x:Name="TxtCpuQuick" Text="0%" Style="{StaticResource ValueTextStyle}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- RAM Widget -->
                <Button x:Name="BtnRam" Click="BtnRam_Click"
                        ToolTip="Monitor de Memória RAM"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6,2" Height="34">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#26FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="▦" FontFamily="Segoe UI Symbol" FontSize="12" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <ProgressBar x:Name="BarRamQuick" Width="26" Height="5" Maximum="100" Value="0" Style="{StaticResource FluentProgressBarStyle}" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock x:Name="TxtRamQuick" Text="0%" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Disk Widget -->
                <Button x:Name="BtnDisk" Click="BtnDisk_Click"
                        ToolTip="Monitor de Disco (Leitura/Escrita)"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6,2" Height="34">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#26FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🖴" FontFamily="Segoe UI Symbol" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock x:Name="TxtDiskQuick" Text="0 KB/s" Style="{StaticResource LabelTextStyle}" FontSize="10" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Network Widget -->
                <Button x:Name="BtnNet" Click="BtnNet_Click"
                        ToolTip="Monitor de Rede (Download/Upload)"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6,2" Height="34">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#26FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⇅" FontSize="12" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" Margin="0,0,2,0" />
                        <TextBlock x:Name="TxtNetQuick" Text="0 KB/s" Style="{StaticResource LabelTextStyle}" FontSize="10" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Clock / Date Widget -->
                <Border Background="#1AFFFFFF" CornerRadius="10" Padding="8,4" Margin="4,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtClock" Text="12:00" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
