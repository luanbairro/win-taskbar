<Window x:Class="WinTaskbar.Views.StartMenuFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Menu Iniciar"
        Width="540" Height="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Deactivated="Window_Deactivated"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <ResourceDictionary Source="/Styles/FluentTheme.xaml" />
    </Window.Resources>

    <!-- Main Glass Container -->
    <Border Background="#E618181B"
            BorderBrush="{StaticResource FlyoutBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="6" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <!-- Search Box -->
                <RowDefinition Height="Auto" />
                <!-- Content Area (Grid or Search Results) -->
                <RowDefinition Height="*" />
                <!-- Footer (User & Power) -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Search Bar -->
            <Border Grid.Row="0"
                    Background="#2A2A2E"
                    BorderBrush="#3D3D42"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,8"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="🔍" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />

                    <TextBox x:Name="TxtSearch"
                             Grid.Column="1"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             CaretBrush="{StaticResource AccentCyanBrush}"
                             FontSize="14"
                             FontFamily="Segoe UI Variable Text, Segoe UI"
                             VerticalAlignment="Center"
                             TextChanged="TxtSearch_TextChanged"
                             KeyDown="TxtSearch_KeyDown" />

                    <TextBlock x:Name="TxtSearchPlaceholder"
                               Grid.Column="1"
                               Text="Digite para pesquisar aplicativos..."
                               Foreground="#66FFFFFF"
                               FontSize="14"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Column="2"
                               Text="ESC p/ fechar"
                               FontSize="11"
                               Foreground="#55FFFFFF"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </Grid>
            </Border>

            <!-- Content Area 1: Search Results List (Visible when searching) -->
            <ListView x:Name="ListSearchResults"
                      Grid.Row="1"
                      Background="Transparent"
                      BorderThickness="0"
                      Visibility="Collapsed"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      MouseDoubleClick="ListSearchResults_MouseDoubleClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#202024"
                                CornerRadius="8"
                                Padding="10,8"
                                Margin="0,3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Image Grid.Column="0" Source="{Binding Icon}" Width="26" Height="26" VerticalAlignment="Center" HorizontalAlignment="Left" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>

                                <Border Grid.Column="2" Background="#33FFFFFF" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="Abrir ↵" FontSize="10" Foreground="{StaticResource AccentCyanBrush}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Content Area 2: Default Start Menu (Visible when search is empty) -->
            <ScrollViewer x:Name="ScrollDefaultContent"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Header Fixados -->
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Fixados &amp; Recomendados"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Left" />
                        <TextBlock Text="Todos os apps ›"
                                   FontSize="11"
                                   Foreground="{StaticResource AccentCyanBrush}"
                                   HorizontalAlignment="Right"
                                   Cursor="Hand"
                                   MouseLeftButtonUp="BtnAllApps_Click" />
                    </Grid>

                    <!-- Pinned Grid -->
                    <ItemsControl x:Name="ItemsPinnedApps">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Margin="4,6"
                                        Padding="6,10"
                                        Click="BtnAppItem_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#2BFFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel HorizontalAlignment="Center">
                                        <Image Source="{Binding Icon}" Width="36" Height="36" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="90" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Quick Tools Separator -->
                    <Border Height="1" Background="#26FFFFFF" Margin="0,16,0,14" />

                    <!-- Quick Windows Utilities -->
                    <TextBlock Text="Ferramentas do Sistema"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,10" />

                    <WrapPanel Orientation="Horizontal">
                        <Button Content="📁 Explorador" Style="{StaticResource QuickPillButton}" Click="BtnExplorer_Click" />
                        <Button Content="💻 Terminal" Style="{StaticResource QuickPillButton}" Click="BtnTerminal_Click" />
                        <Button Content="⚙️ Configurações" Style="{StaticResource QuickPillButton}" Click="BtnSettings_Click" />
                        <Button Content="📊 Tarefas" Style="{StaticResource QuickPillButton}" Click="BtnTaskMgr_Click" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer: User & Power Bar -->
            <Border Grid.Row="2"
                    BorderThickness="0,1,0,0"
                    BorderBrush="#26FFFFFF"
                    Padding="0,14,0,0"
                    Margin="0,12,0,0">
                <Grid>
                    <!-- User Profile Info -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource AccentCyanBrush}">
                            <TextBlock Text="👤" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtUserName" Text="Usuário" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Windows 11" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Power Controls -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button x:Name="BtnLock" ToolTip="Bloquear (Win+L)" Style="{StaticResource PowerIconButton}" Click="BtnLock_Click">
                            <TextBlock Text="🔒" FontSize="13" />
                        </Button>
                        <Button x:Name="BtnSleep" ToolTip="Suspender" Style="{StaticResource PowerIconButton}" Click="BtnSleep_Click">
                            <TextBlock Text="💤" FontSize="13" />
                        </Button>
                        <Button x:Name="BtnRestart" ToolTip="Reiniciar Computador" Style="{StaticResource PowerIconButton}" Click="BtnRestart_Click">
                            <TextBlock Text="🔄" FontSize="13" />
                        </Button>
                        <Button x:Name="BtnShutdown" ToolTip="Desligar Computador" Style="{StaticResource PowerIconButtonRed}" Click="BtnShutdown_Click">
                            <TextBlock Text="⏻" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
