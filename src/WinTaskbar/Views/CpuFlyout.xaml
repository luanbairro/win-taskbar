<Window x:Class="WinTaskbar.Views.CpuFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WinTaskbar.Controls"
        Title="CPU Flyout"
        Width="310" Height="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <ResourceDictionary Source="/Styles/FluentTheme.xaml" />
    </Window.Resources>

    <Border Background="{StaticResource FlyoutBackgroundBrush}"
            BorderBrush="{StaticResource FlyoutBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45" Direction="270" Color="Black"/>
        </Border.Effect>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Title -->
                <TextBlock Text="CPU" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,8" />

                <!-- Processor Model -->
                <TextBlock x:Name="TxtCpuName" Text="Processador" Style="{StaticResource LabelTextStyle}" 
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,10" />

                <!-- Usage Details -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Total:" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock x:Name="TxtTotalUsage" Grid.Column="1" Text="0%" Style="{StaticResource ValueTextStyle}" />
                </Grid>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Usuário:" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock x:Name="TxtUserUsage" Grid.Column="1" Text="0%" Style="{StaticResource ValueTextStyle}" />
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Sistema:" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock x:Name="TxtSystemUsage" Grid.Column="1" Text="0%" Style="{StaticResource ValueTextStyle}" />
                </Grid>

                <!-- Usage Bar -->
                <ProgressBar x:Name="BarCpuUsage" Style="{StaticResource FluentProgressBarStyle}" Margin="0,0,0,10" />

                <!-- Sparkline Chart -->
                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" Padding="6" Height="85" Margin="0,0,0,4">
                    <controls:SparklineChart x:Name="CpuChart" MaxValue="100" />
                </Border>
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="5 minutos atrás" Style="{StaticResource LabelTextStyle}" FontSize="10" HorizontalAlignment="Left" />
                    <TextBlock Text="agora" Style="{StaticResource LabelTextStyle}" FontSize="10" HorizontalAlignment="Right" />
                </Grid>

                <!-- Processos Principais -->
                <TextBlock Text="Processos principais" Style="{StaticResource TitleTextStyle}" FontSize="12" Margin="0,0,0,6" />
                <ItemsControl x:Name="ListProcesses" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource LabelTextStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding FormattedCpu}" Style="{StaticResource ValueTextStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Uptime -->
                <Border BorderBrush="{StaticResource FlyoutBorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Tempo do sistema ligado" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Center" Margin="0,0,0,2" />
                        <TextBlock x:Name="TxtUptime" Text="0d 00h 00m 00s" Style="{StaticResource ValueTextStyle}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
